  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.\\.?/.*)\\.js$": "$1",
      "^src/(.*)\\.js$": "<rootDir>/../src/$1",
      "^src/(.*)$": "<rootDir>/../src/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageProvider": "v8",
    "setupFilesAfterEnv": [
      "../test/setup.ts"
    ],
    "testTimeout": 30000,
    "detectOpenHandles": true,
    "forceExit": true,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/migrations/",
      "/seeder/",
      "module\\.ts$",
      "main\\.ts$",
      "cli\\.ts$",
      "/src/modules/ocr/",
      "/src/entities/",
      "/shared/infrastructure/database/entities/",
      "/shared/infrastructure/http/",
      "/shared/infrastructure/storage/",
      "/shared/interceptors/",
      "/shared/middleware/",
      "/shared/guards/",
      "security-config\\.ts$",
      "/src/utils/",
      "/src/config/",
      "/src/typeorm/",
      "app\\.controller\\.ts$",
      "app\\.service\\.ts$",
      "/shared/common/",
      "/shared/contracts/",
      "/shared/decorators/",
      "/shared/filters/",
      "\\.dto\\.ts$",
      "\\.enum\\.ts$",
      "\\.interface\\.ts$",
      "types\\.ts$",
      "index\\.ts$",
      "crypto-dotnet\\.util\\.ts$",
      "crypto\\.util\\.ts$",
      "mfa-service\\.ts$",
      "recaptcha-service\\.ts$",
      "security-utils\\.ts$",
      "constants\\.ts$",
      "docx-to-pdf\\.ts$",
      "header-validator\\.ts$",
      "static-file-validator\\.ts$"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    }
  },
  "overrides": {
    "glob": "^11.1.0",
    "js-yaml": "^4.1.1"
  }
