# LandTrax Environment Variables
# ====================================================
# This file contains all the environment variables needed for the application.
# Copy this file to .env and fill in your values before starting the application.
APP_ENV= # development | staging  | testing | production
PORT=3000 # SERVER PORT #DEFAULT
HOST=localhost # SERVER HOST #DEFAULT
APP_VERSION= 1.0.29 # CURRENT VERSION #DEFAULT

S
# ====================
# AUTHENTICATION & TOKEN CONFIGURATION
# ====================
# Authentication is handled by JWT
# This secret is used to sign cookies and encrypt JWT tokens
# Generate with: openssl rand -base64 32
APP_AUTH=  your_app_auth #ENCRYPTED
JWT_ACCESS_SECRET=  your_access_token_secret_key #ENCRYPTED
JWT_REFRESH_SECRET= your_refresh_token_secret_key #ENCRYPTED
JWT_ACCESS_EXPIRATION_TIME= your_access_token_expiration #DEFAULT
JWT_REFRESH_EXPIRATION_TIME= your_refresh_token_expiration #DEFAULT
ENCRYPTION_PASSPHRASE = passprhase_for_encrypting_sensitive_data #ENCRYPTED

# ====================
# DATABASE CONFIGURATION
# ====================
# MSSQL container configuration (for local Docker Compose development)
# The database stores all information, and application state
# MSSQL v2022 is the only supported database provider in LandTrax
DATABASE_PROVIDER= #MSSQL #DEFAULT
DB_HOST= 127.0.0.1 #DEFAULT #ENCRYPTED
DB_PORT= 1433 #DEFAULT #ENCRYPTED
DB_USER= sa #DEFAULT #ENCRYPTED
DB_PASSWORD= root #DEFAULT #ENCRYPTED
DB_NAME= landtrax #DEFAULT #ENCRYPTED

# Creates database schema for all entities registered in this connection.
# Can be used only after connection to the database is established.
# If set to true then it drops the database with all its tables and data
# Set to false when database is already set, to skip database recreation every re-building
# Set to true when there were changes in database/typeORM entities to update and sync the database
ENABLE_DATABASE_SYNCHRONIZATION= false

# Drops the database and all its data.
# Be careful with this method on production since this method will erase all your database tables and their data.
# Can be used only after connection to the database is established.


# Inserts default records to the database
# Be careful with this method on production since it inserts bulk of records, enable SYNCHRONIZATION to avoid duplicate default records
# If set to true then it to initialize the default records
ENABLE_DATABASE_SEEDER= false
# this is required for seeding default users
DEFAULT_PASSWORD = '$2b$10$9ETcuipQezzBDe9Va4PcqO7xEXKoseMknXbnKTAQeDv./yu/9/d9a' # Admin123!

# Database connection string for TypeORM
# Format: mssql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# This is used by the application and TypeORM to connect to your database
# In the app: Used by src/typeorm/data-source.ts to establish database connections
DATABASE_URL= #mssql://mssql:mssql@localhost:5432/landtrax

# ====================
# RECAPTCHA CONFIGURATION
# ====================
# Recaptcha is used for human verification, to minimize bots from the app
# In the app: Used by src/utils/recaptcha.service.ts to establish recaptcha third-party verification
RECAPTCHA_SECRET_KEY= your_recaptcha_secret_key #ENCRYPTED
RECAPTCHA_SITE_KEY= your_recaptcha_site_key # currently not used #ENCRYPTED

# Set to false during development to skip recaptcha verification
# Set to true in production to require recaptcha verification
ENABLE_RECAPTCHA_BYPASS= false #DEFAULT

# ====================
# EMAIL CONFIGURATION (NodeMailer)
# ====================
# Email is used for verification, password reset, and notifications
# In the app: Used by src/administration/auth/email.service.ts
EMAIL_PROVIDER= your_email_provider #SMTP #DEFAULT
SMTP_HOST= smtp.gmail.com #DEFAULT
SMTP_PORT= 465 #DEFAULT
SMTP_SECURE= true #DEFAULT
EMAIL_PASSWORD= your_email_password #ENCRYPTED
EMAIL_USER= your_email_sender #ENCRYPTED
EMAIL_FROM= your_email_sender #DEFAULT
# Used in Email-templates for Branding
LOGO_URL = your_frontend_web_logo

# ====================
# APPLICATION CONFIGURATION
# ====================
# General application settings that affect multiple components
# Base URL of your application (used for callbacks, email links, etc.)
# The API url would be also registered in the CORS
# Format: https://yourdomain.com or http://localhost:3000 for development
# In the app: Used for generating absolute URLs for email links and callbacks, CORS registry
FRONTEND_URL= your_api_url

# ====================
# CORS CONFIGURATION
# ====================
# Comma-separated list of allowed origins for CORS
# Only these domains will be able to make requests to your API
# Example: https://yourdomain.com,https://staging.yourdomain.com,http://localhost:3000
# In the app: Used by src/main.ts for CORS origin validation
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://elodgement-staging.lares.com.ph,https://elodgement-uat.lares.com.ph,https://elodgement.lares.com.ph

# ====================
# AWS TEXTRACT CONFIGURATION
# ====================
# AWS Textract is used for document text extraction and analysis
# This is the legacy OCR system that maintains backward compatibility
# Uses standard AWS credentials (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from File Storage section)
# In the app: Used by src/modules/ocr/services/ocr-service.ts for Textract operations
#
# ENDPOINT SELECTION APPROACH:
# - Legacy /ocr/* endpoints automatically use Textract (no changes needed)
# - Existing frontend code continues to work without modifications
# - All current OCR functionality preserved through these endpoints
# DEPRECATED, this is not used.
# AWS_TEXTRACT_REGION= your_aws_textract_region

# Optional Textract-specific timeout and retry configuration
# If not specified, defaults will be used
# TEXTRACT_REQUEST_TIMEOUT= 45000
# TEXTRACT_CONNECTION_TIMEOUT= 8000
# TEXTRACT_MAX_RETRIES= 3
# TEXTRACT_BASE_RETRY_DELAY= 1000
# TEXTRACT_MAX_RETRY_DELAY= 30000
# TEXTRACT_RETRY_JITTER= true

# ====================
# AWS BEDROCK CONFIGURATION
# ====================
# AWS Bedrock is used for enhanced OCR processing with AI models
# This enables the dual-system OCR architecture alongside AWS Textract
# Uses AWS credentials (can be same as File Storage or dedicated credentials)
# In the app: Used by src/modules/ocr/services/ocr-service.ts for Bedrock operations
#
# DUAL-SYSTEM DEPLOYMENT GUIDANCE:
# - Both Textract and Bedrock systems run simultaneously
# - Frontend developers choose systems via endpoint selection:
#   * Legacy /ocr/* endpoints → AWS Textract (backward compatible)
#   * New /ocr/bedrock/* endpoints → AWS Bedrock (enhanced features)
# - Both systems require valid AWS credentials to function
# - If either system's credentials are missing, only that system will be disabled
#
AWS_BEDROCK_ACCESS_KEY_ID= your_aws_bedrock_access_key_id #ENCRYPTED
AWS_BEDROCK_SECRET_ACCESS_KEY= your_aws_bedrock_secret_access_key #ENCRYPTED
AWS_BEDROCK_REGION= your_aws_bedrock_region #ENCRYPTED

# Model Configuration
BEDROCK_MODEL_ID= anthropic.claude-3-haiku-20240307-v1:0 #DEFAULT
BEDROCK_MAX_TOKENS= 4096 #DEFAULT
BEDROCK_TEMPERATURE= 0.1 #DEFAULT

# Connection and Timeout Configuration
BEDROCK_REQUEST_TIMEOUT= 60000 #DEFAULT
BEDROCK_CONNECTION_TIMEOUT= 10000 #DEFAULT

# Retry Configuration for Enhanced Reliability
BEDROCK_MAX_RETRIES= 3 #DEFAULT
BEDROCK_BASE_RETRY_DELAY= 1000 #DEFAULT
BEDROCK_MAX_RETRY_DELAY= 30000 #DEFAULT
BEDROCK_RETRY_JITTER= true #DEFAULT

# ====================
# FILE STORAGE (AWS S3)
# ====================
# File storage is used for user uploads like profile pictures and documents
# Spaces is AWS's S3-compatible object storage service
# In the app: Used by src/services/storage/s3-storage.service.ts
CLOUD_STORAGE_PROVIDER= your_cloud_storage_provider # AWS #ENCRYPTED
AWS_ACCESS_KEY_ID= your_cloud_storage_access_key #ENCRYPTED
AWS_SECRET_ACCESS_KEY= your_cloud_storage_secret_key #ENCRYPTED
AWS_REGION= your_cloud_storage_region #ENCRYPTED
AWS_S3_BUCKET= your_cloud_storage_bucket #ENCRYPTED

# ====================
# COLLECTION/BILLING CONFIGURATION (Maya Business)
# ====================
# MayaBusiness handles all collections, collection processing, and customer management, payment-methods(debit/credit card/e-wallet)
# In the app: Used by src/collection/collection.service.ts
MAYA_MERCHANT_ACCOUNT_NO= your_maya_merchant_account_no #ENCRYPTED
MAYA_ENVIRONMENT= # SANDBOX | PRODUCTION
MAYA_BASE_URL= # SANDBOX = https://pg-sandbox.paymaya.com | PRODUCTION = https://pg.paymaya.com
# CARD
MAYA_MERCHANT_ID= your_maya_merchant_id #ENCRYPTED
MAYA_PUBLIC_API_KEY= your_maya_public_api_key #ENCRYPTED
MAYA_SECRET_API_KEY= your_maya_secret_api_key #ENCRYPTED
# E-WALLET
MAYA_WALLET_MERCHANT_ID = LANDTRAX Checkout with PWM - LANDTRAX (PHP)
MAYA_WALLET_PUBLIC_API_KEY = pk-5mWrdu3vanbfQcuLGeNiVEPZDfv2qsfi0012u5dT8wa # qn-prod-server # Expiration:	07/20/2126 11:39:12 PM
MAYA_WALLET_SECRET_API_KEY = sk-OaHNk4yTxKCP3v0HOHqbMZBqgQrtG6MbIRec24mFWQE # qn-prod-server # Expiration:	07/20/2126 11:40:44 PM

# Optional: Set logging level (default: info)
# Controls the verbosity of application logs
# Valid values: error, warn, info, debug
# LOG_LEVEL=info
# LOG_FILES=./logs


# ====================
# REDIS CONFIGURATION (BullMQ)
# ====================
# Used for queue-backed mass notifications.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to 'true' if using AWS ElastiCache / Upstash / Redis Enterprise
REDIS_TLS=false
# Set to 'true' to connect to a Redis cluster (e.g. AWS ElastiCache Cluster Mode)
REDIS_CLUSTER=false
# Comma-separated sentinel nodes (host:port) for HA Redis Sentinel setups
REDIS_SENTINELS=host1:26379,host2:26379
REDIS_SENTINEL_NAME=mymaster
# Full Redis connection URL (e.g. Upstash: rediss://:password@host:port)
REDIS_URL= #rediss://:password@host:port
# Set to true if redis is already configured
REDIS_ENABLED = true

# ====================
# NOTIFICATION QUEUE CONFIGURATION (BullMQ Workers)
# ====================
# Number of parallel jobs each notification worker processes concurrently
NOTIFICATION_WORKER_CONCURRENCY=5
# Max number of users per bulk notification chunk (per BullMQ job)
NOTIFICATION_BULK_CHUNK_SIZE=50
# Max retry attempts for a failed notification job before moving to the dead-letter queue
NOTIFICATION_MAX_RETRIES=3
# Initial delay (ms) for exponential backoff on retry
NOTIFICATION_RETRY_DELAY_MS=2000
